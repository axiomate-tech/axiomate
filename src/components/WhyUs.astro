---
import Icon from "./Icon.astro";
import { why } from "../data/content";
---

<section class="section" id="why">
  <div class="container why-grid">
    <div class="why-intro reveal">
      <p class="eyebrow">{why.eyebrow}</p>
      <h2>{why.title}</h2>
      <p class="lead">{why.lead}</p>
      <a href="#contact" class="btn btn-ghost why-cta">
        Start a conversation<Icon name="arrow" class="arrow" size={16} />
      </a>
    </div>

    <ul class="why-list" role="list">
      {
        why.items.map((f, i) => (
          <li class="why-item reveal" style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <span class="icon-chip">
              <Icon name={f.icon} />
            </span>
            <div>
              <h3 class="why-item-title">{f.title}</h3>
              <p class="muted">{f.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    gap: clamp(2.5rem, 1rem + 5vw, 4rem);
    align-items: start;
  }
  .why-intro h2 { font-size: var(--fs-h2); margin-top: 1rem; }
  .why-intro .lead { margin-top: 1.1rem; }
  .why-cta { margin-top: 1.75rem; }

  .why-list {
    display: grid;
    gap: 1.4rem 2rem;
  }
  .why-item { display: flex; gap: 1rem; }
  .why-item .icon-chip { flex-shrink: 0; width: 2.7rem; height: 2.7rem; }
  .why-item .icon-chip :global(svg) { width: 1.3rem; height: 1.3rem; }
  .why-item-title { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .why-item p { font-size: var(--fs-sm); }

  @media (min-width: 940px) {
    .why-grid { grid-template-columns: 0.85fr 1.15fr; }
    .why-intro { position: sticky; top: 6rem; }
    .why-list { grid-template-columns: 1fr 1fr; }
  }
</style>
