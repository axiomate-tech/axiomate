---
import { marquee } from "../data/content";
const loop = [...marquee.items, ...marquee.items];
---

<section class="marquee-sec" aria-label="Technologies we work with">
  <div class="container">
    <p class="marquee-label">{marquee.label}</p>
  </div>
  <div class="marquee">
    <ul class="track" role="list">
      {
        loop.map((item, i) => (
          <li class="m-item" aria-hidden={i >= marquee.items.length ? "true" : undefined}>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee-sec { padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  .marquee-label {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 1.75rem;
  }
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding-inline: 0.85rem;
    animation: marquee 46s linear infinite;
  }
  .marquee:hover .track { animation-play-state: paused; }
  .m-item {
    flex-shrink: 0;
    padding: 0.6rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .m-item:hover { color: var(--cyan-300); border-color: var(--border-glow); }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .marquee { -webkit-mask-image: none; mask-image: none; }
  }
</style>
