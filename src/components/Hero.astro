---
import Icon from "./Icon.astro";
import { hero } from "../data/content";
---

<section class="hero" id="top">
  <div class="grid-overlay" aria-hidden="true"></div>
  <div class="glow-orb orb-a" aria-hidden="true"></div>
  <div class="glow-orb orb-b" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal">{hero.eyebrow}</p>
      <h1 class="hero-title reveal" style="--reveal-delay:60ms">
        {hero.headlineLead}{" "}
        <span class="text-gradient">{hero.headlineAccent}</span>
      </h1>
      <p class="lead hero-sub reveal" style="--reveal-delay:120ms">{hero.sub}</p>

      <div class="hero-cta reveal" style="--reveal-delay:180ms">
        <a href={hero.primaryCta.href} class="btn btn-primary btn-lg">
          {hero.primaryCta.label}<Icon name="arrow" class="arrow" size={18} />
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-ghost btn-lg">{hero.secondaryCta.label}</a>
      </div>

      <ul class="hero-proof reveal" style="--reveal-delay:240ms" role="list">
        {
          hero.proof.map((p) => (
            <li>
              <Icon name="check" size={15} /> {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-visual reveal" style="--reveal-delay:160ms" aria-hidden="true">
      <div class="hv-card">
        <div class="hv-top">
          <span class="hv-dot"></span><span class="hv-dot"></span><span class="hv-dot"></span>
          <span class="hv-name">axiomate · live pipeline</span>
          <span class="hv-live"><i></i>operational</span>
        </div>

        <div class="hv-flow">
          <div class="hv-node">
            <span class="hv-ic"><Icon name="cloud" size={20} /></span>
            <span class="hv-label">Cloud<small>ingest &amp; store</small></span>
          </div>
          <div class="hv-rail"><span class="hv-pulse"></span></div>
          <div class="hv-node">
            <span class="hv-ic"><Icon name="automation" size={20} /></span>
            <span class="hv-label">Automate<small>orchestrate work</small></span>
          </div>
          <div class="hv-rail"><span class="hv-pulse" style="animation-delay:1.1s"></span></div>
          <div class="hv-node is-accent">
            <span class="hv-ic"><Icon name="ai" size={20} /></span>
            <span class="hv-label">AI<small>decide &amp; act</small></span>
          </div>
        </div>

        <div class="hv-metrics">
          <div><b>99.9%</b><span>uptime</span></div>
          <div><b>−40%</b><span>cloud cost</span></div>
          <div><b>3×</b><span>faster</span></div>
        </div>
      </div>

      <div class="hv-chip chip-1"><span class="ok"><Icon name="check" size={13} /></span> deploy · 2m ago</div>
      <div class="hv-chip chip-2"><span class="pulse-dot"></span> 1,204 tasks automated today</div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(5rem, 4rem + 9vw, 9rem) var(--section-y);
    overflow: hidden;
    isolation: isolate;
  }
  .orb-a {
    width: 60vw;
    max-width: 720px;
    aspect-ratio: 1;
    top: -22%;
    right: -10%;
    background: radial-gradient(circle, rgba(var(--cyan-rgb) / 0.5), transparent 65%);
    animation: drift 18s var(--ease) infinite alternate;
  }
  .orb-b {
    width: 46vw;
    max-width: 540px;
    aspect-ratio: 1;
    bottom: -28%;
    left: -14%;
    background: radial-gradient(circle, rgba(var(--azure-rgb) / 0.34), transparent 65%);
    animation: drift 22s var(--ease) infinite alternate-reverse;
  }
  @keyframes drift {
    to { transform: translate3d(4%, 5%, 0) scale(1.08); }
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 1rem + 5vw, 4.5rem);
    align-items: center;
  }

  .hero-title {
    font-size: var(--fs-display);
    margin-top: 1.4rem;
    letter-spacing: -0.03em;
  }
  .hero-sub { margin-top: 1.5rem; max-width: 38ch; }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.2rem; }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.2rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .hero-proof li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero-proof :global(svg) { color: var(--cyan-400); flex-shrink: 0; }

  /* ---- Visual ---- */
  .hero-visual { position: relative; }
  .hv-card {
    position: relative;
    z-index: 2;
    padding: 1.1rem 1.1rem 1.3rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg), 0 0 80px -30px rgba(var(--cyan-rgb) / 0.5);
    backdrop-filter: blur(10px);
  }
  .hv-top {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.95rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .hv-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--surface-3); }
  .hv-dot:nth-child(1) { background: #ff5f57; opacity: 0.7; }
  .hv-dot:nth-child(2) { background: #febc2e; opacity: 0.7; }
  .hv-dot:nth-child(3) { background: #28c840; opacity: 0.7; }
  .hv-name {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--faint);
  }
  .hv-live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--cyan-300);
  }
  .hv-live i {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--cyan-400);
    box-shadow: 0 0 0 0 rgba(var(--cyan-rgb) / 0.7);
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { box-shadow: 0 0 0 0 rgba(var(--cyan-rgb) / 0.6); }
    50% { box-shadow: 0 0 0 6px rgba(var(--cyan-rgb) / 0); }
  }

  .hv-flow { display: flex; flex-direction: column; }
  .hv-node {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .hv-node.is-accent {
    border-color: rgba(var(--cyan-rgb) / 0.45);
    background: linear-gradient(120deg, rgba(var(--cyan-rgb) / 0.14), var(--surface-2));
    box-shadow: 0 0 36px -14px rgba(var(--cyan-rgb) / 0.7);
  }
  .hv-ic {
    display: grid;
    place-items: center;
    width: 2.4rem; height: 2.4rem;
    border-radius: 10px;
    color: var(--cyan-300);
    background: rgba(var(--cyan-rgb) / 0.1);
    border: 1px solid rgba(var(--cyan-rgb) / 0.22);
  }
  .hv-label { display: flex; flex-direction: column; font-weight: 600; color: var(--text-strong); }
  .hv-label small { font-weight: 400; font-size: 0.78rem; color: var(--faint); }

  .hv-rail {
    position: relative;
    width: 2px;
    height: 1.4rem;
    margin-left: 2.2rem;
    background: linear-gradient(var(--border-2), transparent);
  }
  .hv-pulse {
    position: absolute;
    left: 50%;
    top: 0;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--cyan-300);
    box-shadow: 0 0 10px 2px rgba(var(--cyan-rgb) / 0.8);
    translate: -50% 0;
    animation: flow 2.2s var(--ease) infinite;
  }
  @keyframes flow {
    0% { top: -2px; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  .hv-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    margin-top: 1.2rem;
  }
  .hv-metrics div {
    text-align: center;
    padding: 0.7rem 0.3rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .hv-metrics b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--cyan-300);
  }
  .hv-metrics span { font-size: 0.72rem; color: var(--faint); }

  .hv-chip {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text);
    background: rgba(17, 22, 31, 0.85);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow);
    backdrop-filter: blur(8px);
  }
  .chip-1 { top: 6%; left: -5%; animation: float 6s var(--ease) infinite; }
  .chip-2 { bottom: -6%; right: -2%; animation: float 7.5s var(--ease) infinite 0.6s; }
  .hv-chip .ok {
    display: grid; place-items: center;
    width: 18px; height: 18px; border-radius: 50%;
    color: #04181a; background: var(--cyan-400);
  }
  .pulse-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--cyan-400);
    box-shadow: 0 0 8px 1px rgba(var(--cyan-rgb) / 0.8);
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: 1.05fr 0.95fr; }
  }
  /* Floating chips are a desktop flourish; on narrow screens they overlap
     the card content, so hide them and let the card stand on its own. */
  @media (max-width: 640px) {
    .hv-chip { display: none; }
  }
</style>
